# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
CONFIG_PATH=config/config.yaml

# --- Redis (rate limiting / budget counters) ---
REDIS_URL=redis://redis:6379/0

# --- Provider API keys (mocked in Phase 0, real keys later) ---
OPENAI_API_KEY=sk-changeme
ANTHROPIC_API_KEY=sk-ant-changeme
OLLAMA_BASE_URL=http://ollama:11434

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=llm-gateway
PROMETHEUS_METRICS_PORT=9100

# --- Grafana (compose only, not read by the app) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
